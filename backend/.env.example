# คัดลอกเป็น .env แล้วแก้ค่า — ทุกค่าไม่บังคับ (ไม่มี .env เลยก็รันได้)
# ค่าทั้งหมดถูกอ่านที่ src/config.js ที่เดียว

PORT=5000

# ---------- ฐานข้อมูล MariaDB ----------
# ใส่ DB_USER + DB_NAME = ใช้ MariaDB (สร้างตารางให้เองตอนเริ่ม)
# ลบหรือ comment ทั้ง 4 บรรทัดนี้ = เก็บข้อมูลในไฟล์ data/store.json แทน (เหมาะกับเครื่อง dev)
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# ---------- รหัสผู้ดูแล ----------
# ใช้สร้างบัญชี Admin คนแรก และให้สคริปต์ import ส่งมาใน header x-admin-secret
# ไม่ตั้ง + ยังไม่มีผู้ใช้ = ทุกคนแก้ข้อมูลได้ (โหมดเปิด)
ADMIN_SECRET=your_admin_secret_here

# ---------- โหมดไฟล์ (ใช้เมื่อไม่ได้ตั้งค่า DB) ----------
# STORE_FILE=data/store.json     # ที่เก็บไฟล์ (อ้างจากโฟลเดอร์ backend/) — off = ไม่บันทึก ข้อมูลหายเมื่อ restart

# ---------- ไฟล์ Excel ประจำโปรเจกต์ ----------
# XLSX_FILE=data/CCTV-MECHA-PART.xlsx   # ไฟล์ที่ซิงก์อัตโนมัติ / ปุ่ม "ใช้ไฟล์ในโปรเจกต์"
# XLSX_WATCH=off                        # ปิดการเฝ้าไฟล์ (ปิดถาวรจากหน้าเว็บได้ที่ Settings → นำเข้าจาก Excel)
